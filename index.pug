mixin simpleIcon(slug, label, extraClass)
  img.simple-icon(class=extraClass src=`https://cdn.jsdelivr.net/npm/simple-icons@v16/icons/${slug}.svg` width="20" height="20" alt=label loading="lazy")

mixin sectionHeader(title, subtitle, row)
  header.section__header(class=row ? "section__header--row" : "")
    h2.section__title= title
    if subtitle
      if row
        p.section__hint= subtitle
      else
        p.section__subtitle= subtitle

mixin serviceDetailCard(group)
  article.detail-card(id=group.id class=`detail-card--${group.className}`)
    .detail-card__top
      span.detail-card__marker(aria-hidden="true")= group.icon
      .detail-card__heading
        h3.detail-card__title= group.title
        p.detail-card__summary= group.summary
    if group.intro
      p.detail-card__intro= group.intro
    ul.detail-list
      each item in group.items
        li= item
    a.detail-card__action(
      href=whatsapp(group.message)
      target="_blank"
      rel="noopener noreferrer"
    )
      | Consultar por WhatsApp
      span(aria-hidden="true") →

mixin productCard(product)
  article.product-card(id=product.id class=`product-card--${product.className}`)
    .product-card__media(aria-hidden="true")
      span.product-card__icon BP
    .product-card__content
      h3.product-card__title= product.title
      p.product-card__text= product.text
      a.product-card__action(
        href=whatsapp(product.message)
        target="_blank"
        rel="noopener noreferrer"
      )
        | Cotizar por WhatsApp
        span(aria-hidden="true") →

mixin branchCard(branch)
  article.branch-card
    .branch-card__photo
      img.branch-card__image(src="img/StreadView.jpg" alt=`Fachada de ${branch.name}`)
    .branch-card__content
      h3.branch-card__title= branch.name
      p.branch-card__meta
        strong Categoría:
        |  #{branch.category}
      p.branch-card__text= branch.address
      p.branch-card__meta
        strong Plus code:
        |  #{branch.plusCode}
      p.branch-card__meta
        strong Teléfono:
        |  #{branch.phone}
      p.branch-card__meta
        strong Correo:
        |  #{branch.email}
      .branch-card__footer
        span.tag= branch.schedule
      a.branch-card__maps(
        href="https://www.google.com/maps?cid=3724333998245387144"
        target="_blank"
        rel="noopener noreferrer"
      )
        | Abrir en Google Maps
        span(aria-hidden="true") ↗

mixin footerLinks(title, links)
  .footer-col
    h3.footer-title= title
    ul.footer-list
      each link in links
        li
          a(href=link.href)= link.label

html(lang="es")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title CopyServices - Papelería, trámites y Puntored
    link(rel="stylesheet" href="css/styles.css")

  body
    .page-shell#inicio
      header.site-header
        .container.header-row
          a.brand(href="#inicio" aria-label="Inicio")
            span.brand__mark(aria-hidden="true")
              img.brand__logo(src="Logos/logo_copyservices_exact.svg" alt="")
            span.brand__text
              span.brand__name CopyServices
              span.brand__tagline Donde tus ideas toman forma.

          nav.header-icons(aria-label="Acciones rápidas")
            a.icon-btn(href="#contacto" aria-label="Contacto")
              span.icon ?
            a.icon-btn(
              href="https://www.facebook.com/p/Copyservices-100086411343836"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Facebook"
            )
              +simpleIcon("facebook", "Facebook")
            a.icon-btn(
              href=whatsapp("Hola, quiero información sobre CopyServices.")
              target="_blank"
              rel="noopener noreferrer"
              aria-label="WhatsApp"
            )
              +simpleIcon("whatsapp", "WhatsApp")

          button.nav-toggle(type="button" aria-label="Abrir navegación" aria-expanded="false" data-nav-toggle)
            span.nav-toggle__bar
            span.nav-toggle__bar
            span.nav-toggle__bar

        .nav-strip
          .container
            nav.main-nav(aria-label="Navegación principal" data-main-nav)
              each item in navItems
                a.main-nav__link(href=item.href)= item.label

      section.hero(aria-label="Servicios CopyServices")
        .container
          .hero-panel(role="img" aria-label="Papelería, trámites y servicios digitales CopyServices")
            .hero-panel__printer
            .hero-panel__stationery
            .hero-panel__dots(aria-hidden="true")
              span.is-active
              span
              span

      main
        section.section.section--services#servicios
          .container
            +sectionHeader("Servicios", "Papelería, oficina, trámites y Puntored en un solo lugar.")
            .service-list-grid
              each group in serviceGroups
                +serviceDetailCard(group)

        section.section.section--soft#productos
          .container
            +sectionHeader("Productos", "Producto disponible para publicidad, eventos y promoción de marca.", true)
            .product-grid
              each product in products
                +productCard(product)

        section.section.section--branch#sede
          .container
            +sectionHeader("Nuestra sede", "Visita nuestra sede estratégicamente ubicada.")

            .branches
              aside.branches__left(aria-label="Sede principal")
                +branchCard(branch)

              .branches__map(aria-label="Mapa")
                iframe(
                  title="Mapa - Sede Copyservices"
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  src="https://www.google.com/maps?cid=3724333998245387144&output=embed"
                  data-map-frame
                )

      footer.site-footer#contacto
        .container.footer-top
          .footer-col
            h3.footer-title Contacto
            ul.footer-list
              li
                span.muted WhatsApp:
                |  +57 320 2878530
              li
                span.muted Correo:
                |  copyservices.co@gmail.com
              li
                a(href="https://www.google.com/maps?cid=3724333998245387144" target="_blank" rel="noopener noreferrer") Ver ubicación en Google Maps

            .footer-social(aria-label="Redes sociales y contacto")
              a.social(
                href=whatsapp("Hola, quiero información sobre CopyServices.")
                target="_blank"
                rel="noopener noreferrer"
                aria-label="WhatsApp"
              )
                +simpleIcon("whatsapp", "WhatsApp")
              a.social(
                href="https://www.facebook.com/p/Copyservices-100086411343836"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Facebook"
              )
                +simpleIcon("facebook", "Facebook")

          +footerLinks("Servicios", footerServices)
          +footerLinks("Productos", footerProducts)

        .footer-bottom
          .container.footer-bottom__row
            span.muted © 2026 CopyServices
            span.muted Papelería, trámites y Puntored en Cali

    a.whatsapp-float(
      href=whatsapp("Hola, quiero información sobre CopyServices.")
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Abrir chat de WhatsApp"
    )
      +simpleIcon("whatsapp", "WhatsApp", "whatsapp-float__icon")
    script(src="js/main.js")
