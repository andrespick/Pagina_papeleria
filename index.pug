doctype html

mixin simpleIcon(slug, label, extraClass)
  img.simple-icon(class=extraClass src=`https://cdn.jsdelivr.net/npm/simple-icons@v16/icons/${slug}.svg` width="20" height="20" alt=label loading="lazy")

mixin sectionHeader(title, subtitle, row)
  header.section__header(class=row ? "section__header--row" : "")
    h2.section__title= title
    if subtitle
      if row
        p.section__hint= subtitle
      else
        p.section__subtitle= subtitle

mixin serviceDetailSection(group)
  section.section.service-section(id=group.id class=`service-section--${group.className}`)
    .container
      .service-detail(class=`service-detail--${group.className}`)
        span.service-detail__marker(aria-hidden="true")
          img.service-detail__icon(src=group.iconSrc alt="" loading="lazy" decoding="async")
        .service-detail__content
          h3.service-detail__title= group.title
          p.service-detail__summary= group.summary
          if group.intro
            p.service-detail__intro= group.intro
          ul.detail-list
            each item in group.items
              li= item
          a.service-detail__action(
            href=whatsapp(group.message)
            target="_blank"
            rel="noopener noreferrer"
          )
            | Consultar por WhatsApp
            span(aria-hidden="true") →

mixin productCard(product)
  article.product-card(id=product.id class=`product-card--${product.className}`)
    .product-card__media
      img.product-card__image(src=product.image alt=product.imageAlt loading="lazy" decoding="async")
    .product-card__content
      h3.product-card__title= product.title
      p.product-card__text= product.text
      a.product-card__action(
        href=whatsapp(product.message)
        target="_blank"
        rel="noopener noreferrer"
      )
        | Cotizar por WhatsApp
        span(aria-hidden="true") →

mixin branchCard(branch)
  article.branch-card
    .branch-card__photo
      img.branch-card__image(src=branch.image alt=`Fachada de ${branch.name}`)
    .branch-card__content
      h3.branch-card__title= branch.name
      p.branch-card__meta
        strong Categoría:
        |  #{branch.category}
      p.branch-card__text= branch.address
      p.branch-card__meta
        strong Teléfono:
        |  #{branch.phone}
      p.branch-card__meta
        strong Correo:
        |  #{branch.email}
      .branch-card__footer
        span.tag= branch.schedule
      a.branch-card__maps(
        href=branch.mapUrl
        target="_blank"
        rel="noopener noreferrer"
      )
        | Abrir en Google Maps
        span(aria-hidden="true") ↗

mixin footerLinks(title, links)
  .footer-col
    h3.footer-title= title
    ul.footer-list
      each link in links
        li
          a(href=link.href)= link.label

html(lang="es")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title= brand.title
    link(rel="icon" type="image/svg+xml" href=brand.logo)
    link(rel="stylesheet" href="css/styles.css")

  body
    .page-shell#inicio
      header.site-header
        .container.header-row
          a.brand(href="#inicio" aria-label="Inicio")
            span.brand__mark(aria-hidden="true")
              img.brand__logo(src=brand.logo alt="")
            span.brand__text
              span.brand__name= brand.name
              span.brand__tagline= brand.tagline

          nav.header-icons(aria-label="Acciones rápidas")
            a.icon-btn(
              href=contact.facebookUrl
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Facebook"
            )
              +simpleIcon("facebook", "Facebook")
            a.icon-btn(
              href=whatsapp(contact.defaultMessage)
              target="_blank"
              rel="noopener noreferrer"
              aria-label="WhatsApp"
            )
              +simpleIcon("whatsapp", "WhatsApp")

          button.nav-toggle(type="button" aria-label="Abrir navegación" aria-expanded="false" data-nav-toggle)
            span.nav-toggle__bar
            span.nav-toggle__bar
            span.nav-toggle__bar

        .nav-strip
          .container
            nav.main-nav(aria-label="Navegación principal" data-main-nav)
              each item in navItems
                a.main-nav__link(href=item.href)= item.label

      section.hero(aria-label="Servicios CopyServices")
        .container
          .hero-panel
            img.hero-panel__image(
              src=hero.image
              alt=hero.alt
              decoding="async"
              fetchpriority="high"
            )

      main
        section.section.section--services#servicios
          .container
            +sectionHeader("Servicios", "Papelería, oficina, trámites y Puntored en un solo lugar.")

        each group in serviceGroups
          +serviceDetailSection(group)

        section.section.section--soft#productos
          .container
            +sectionHeader("Productos", "Personalización para publicidad, regalos, eventos y promoción de marca.", true)
            .product-grid
              each product in products
                +productCard(product)

        section.section.section--branch#sede
          .container
            +sectionHeader("Nuestra sede", "Visita nuestra sede estratégicamente ubicada.")

            .branches
              aside.branches__left(aria-label="Sede principal")
                +branchCard(branch)

              .branches__map(aria-label="Mapa")
                iframe(
                  title="Mapa - Sede Copyservices"
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  src=branch.mapEmbedUrl
                  data-map-frame
                )

      footer.site-footer#contacto
        .container.footer-top
          .footer-col
            h3.footer-title Contacto
            ul.footer-list
              li
                span.muted WhatsApp:
                |  #{contact.phone}
              li
                span.muted Correo:
                |  #{contact.email}
              li
                a(href=map.url target="_blank" rel="noopener noreferrer") Ver ubicación en Google Maps

            .footer-social(aria-label="Redes sociales y contacto")
              a.social(
                href=whatsapp(contact.defaultMessage)
                target="_blank"
                rel="noopener noreferrer"
                aria-label="WhatsApp"
              )
                +simpleIcon("whatsapp", "WhatsApp")
              a.social(
                href=contact.facebookUrl
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Facebook"
              )
                +simpleIcon("facebook", "Facebook")

          +footerLinks("Servicios", footerServices)
          +footerLinks("Productos", footerProducts)

        .footer-bottom
          .container.footer-bottom__row
            span.muted © 2026 CopyServices
            span.muted Papelería, trámites y Puntored en Cali

    a.whatsapp-float(
      href=whatsapp(contact.defaultMessage)
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Abrir chat de WhatsApp"
    )
      +simpleIcon("whatsapp", "WhatsApp", "whatsapp-float__icon")
    script(src="js/main.js")
