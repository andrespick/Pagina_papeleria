mixin iconButton(label, text, extraClass)
  a.icon-btn(class=extraClass href="#" aria-label=label)
    span.icon= text
    if extraClass === "icon-btn--cart"
      span.badge(aria-label="0 items") 0

mixin simpleIcon(slug, label, extraClass)
  img.simple-icon(class=extraClass src=`https://cdn.jsdelivr.net/npm/simple-icons@v16/icons/${slug}.svg` width="20" height="20" alt=label loading="lazy")

mixin sectionHeader(title, subtitle, row)
  header.section__header(class=row ? "section__header--row" : "")
    h2.section__title= title
    if subtitle
      if row
        p.section__hint= subtitle
      else
        p.section__subtitle= subtitle

mixin serviceCard(service)
  article.service-card(class=`service-card--${service.className}`)
    .service-card__overlay
      h3.service-card__title= service.title
      a.btn.btn--small(href="#") Ver más

mixin miniCard(item)
  a.mini-card(href="#" tabindex="0")
    div(class=`mini-card__img mini-card__img--${item.className}`)
    .mini-card__body
      span.mini-card__title= item.title
      span.mini-card__arrow(aria-hidden="true") →

mixin branchCard(branch)
  article.branch-card
    div(class=`branch-card__photo branch-card__photo--${branch.className}`)
      img.branch-card__image(src="img/StreadView.jpg" alt=`Fachada de ${branch.name}`)
    .branch-card__content
      h3.branch-card__title= branch.name
      if branch.category
        p.branch-card__meta
          strong Categoría:
          |  #{branch.category}
      p.branch-card__text= branch.address
      if branch.plusCode
        p.branch-card__meta
          strong Plus code:
          |  #{branch.plusCode}
      if branch.phone
        p.branch-card__meta
          strong Teléfono:
          |  #{branch.phone}
      if branch.email
        p.branch-card__meta
          strong Correo:
          |  #{branch.email}
      .branch-card__footer
        span.tag= branch.schedule
        button.icon-chip(
          type="button"
          aria-label=`Ver ubicación de ${branch.name}`
          data-map-query=branch.mapQuery || `${branch.name} ${branch.address}`
          data-branch-name=branch.name
        ) ⌖

mixin footerLinks(title, links)
  .footer-col
    h3.footer-title= title
    ul.footer-list
      each link in links
        li
          a(href="#")= link

html(lang="es")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title CopyServices - Home
    link(rel="stylesheet" href="css/styles.css")

  body
    header.site-header
      .container.header-row
        a.brand(href="#" aria-label="Inicio")
          span.brand__mark(aria-hidden="true")
            img.brand__logo(src="Logos/logo_copyservices_exact.svg" alt="")
          span.brand__text
            span.brand__name CopyServices
            span.brand__tagline Donde tus ideas toman forma.

        nav.header-icons(aria-label="Acciones rápidas")
          +iconButton("Ayuda", "?")
          a.icon-btn(
            href="https://www.facebook.com/p/Copyservices-100086411343836"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook"
          )
            +simpleIcon("facebook", "Facebook")
          a.icon-btn(href="#" aria-label="Instagram")
            +simpleIcon("instagram", "Instagram")

        button.nav-toggle(type="button" aria-label="Abrir navegación" aria-expanded="false" data-nav-toggle)
          span.nav-toggle__bar
          span.nav-toggle__bar
          span.nav-toggle__bar

      .nav-strip
        .container
          nav.main-nav(aria-label="Navegación principal" data-main-nav)
            each item in navItems
              a.main-nav__link(href="#")
                | #{item} 
                span(aria-hidden="true") ▾

    section.hero(aria-label="Hero")
      .container.hero-grid
        .hero-shot.hero-shot--left(role="img" aria-label="Mockup cuaderno anillado")
        .hero-shot.hero-shot--right(role="img" aria-label="Mockup libro / catálogo")

    main
      section.section
        .container
          +sectionHeader("Nuestros servicios")
          .service-grid
            each service in services
              +serviceCard(service)

      section.section.section--soft
        .container
          +sectionHeader("Otros servicios", "Soluciones rápidas para impresión, papelería y acabados especiales.", true)

          .carousel(aria-label="Carrusel de otros servicios" data-carousel)
            button.carousel__control.carousel__control--prev(type="button" aria-label="Servicio anterior" data-carousel-prev) ‹
            button.carousel__control.carousel__control--next(type="button" aria-label="Servicio siguiente" data-carousel-next) ›

            .carousel__viewport
              .carousel__track(data-carousel-track)
                each page in otherServicePages
                  .carousel__page(data-carousel-page)
                    each item in page
                      +miniCard(item)

            .carousel__dots(aria-label="Paginación" data-carousel-dots)
              each page, index in otherServicePages
                button.dot(
                  type="button"
                  aria-label=`Página ${index + 1}`
                  aria-current=index === 0 ? "true" : "false"
                  data-carousel-dot=index
                )

      section.section
        .container
          +sectionHeader("Nuestra sede", "¡Visita nuestra sede estratégicamente ubicada!")

          .branches
            aside.branches__left(aria-label="Listado de sedes")
              each branch in branches
                +branchCard(branch)

            .branches__map(aria-label="Mapa")
              iframe(
                title="Mapa - Sedes"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                src="https://www.google.com/maps?cid=3724333998245387144&output=embed"
                data-map-frame
              )

    footer.site-footer
      .container.footer-top
        .footer-col
          h3.footer-title Contacto
          ul.footer-list
            li
              span.muted ☎
              |  +57 320 2878530
            li
              span.muted ✉
              |  copyservices.co@gmail.com

          .footer-social(aria-label="Redes sociales")
            a.social(href="#" aria-label="Instagram")
              +simpleIcon("instagram", "Instagram")
            a.social(
              href="https://www.facebook.com/p/Copyservices-100086411343836"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Facebook"
            )
              +simpleIcon("facebook", "Facebook")

        +footerLinks("Productos", footerProducts)
        +footerLinks("Ayuda", footerHelp)

      .footer-bottom
        .container.footer-bottom__row
          span.muted © 2026 - Maquetación Pug/CSS
          span.muted
            | Edita la página en 
            code index.pug
    a.whatsapp-float(
      href="https://wa.me/573202878530"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Abrir chat de WhatsApp"
    )
      +simpleIcon("whatsapp", "WhatsApp", "whatsapp-float__icon")
    .toast(role="status" aria-live="polite" data-toast)
    script(src="js/main.js")
